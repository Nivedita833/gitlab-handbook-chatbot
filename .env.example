# Optional: choose one provider for generated wording.
# The app still works without these keys in deterministic retrieval mode.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional timeout for LLM calls. Retrieval fallback still works if the LLM times out.
LLM_TIMEOUT_MS=12000

# Local/default deployment port.
PORT=3000
